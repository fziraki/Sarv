// Apple Development Team ID. Empty is fine for the iPhone simulator.
// Fill this in for device / App Store builds (Xcode → Signing & Capabilities).
TEAM_ID=

PRODUCT_NAME=Sarv
PRODUCT_BUNDLE_IDENTIFIER=abkabk.azbarkon.Sarv

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

OTHER_LDFLAGS = $(inherited) -lsqlite3

// Xcode 16+ debug dylib splits the binary and crashes Compose/Kotlin Native on simulator.
ENABLE_DEBUG_DYLIB = NO
