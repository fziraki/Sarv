CREATE TABLE verse (
    poem_id INTEGER NOT NULL,
    vorder INTEGER NOT NULL,
    position INTEGER NOT NULL,
    text TEXT NOT NULL
);

selectByPoemId:
SELECT poem_id, vorder, position, text
FROM verse
WHERE poem_id = ?
ORDER BY vorder, position;

-- Legacy MyDatabase.getRandomDistich(0): position=0, vorder+1 pairing, length<=50,
-- excluded poet ids {0,1,36,60,68}, exclude rubaiyat (getRandomPoem).

selectRandomDistichCount:
SELECT COUNT(*)
FROM verse v1
JOIN verse v2
  ON v2.poem_id = v1.poem_id AND v2.vorder = v1.vorder + 1
JOIN poem ON poem.id = v1.poem_id
JOIN cat ON cat.id = poem.cat_id
JOIN poet ON poet.id = cat.poet_id
WHERE v1.position = 0
  AND length(v1.text) <= 50
  AND length(v2.text) <= 50
  AND poet.id NOT IN (0, 1, 36, 60, 68)
  AND cat.text != 'رباعیات';

selectRandomDistichAtOffset:
SELECT
  v1.poem_id,
  v1.vorder,
  v1.text AS right_text,
  v2.text AS left_text,
  poet.name AS poet_name
FROM verse v1
JOIN verse v2
  ON v2.poem_id = v1.poem_id AND v2.vorder = v1.vorder + 1
JOIN poem ON poem.id = v1.poem_id
JOIN cat ON cat.id = poem.cat_id
JOIN poet ON poet.id = cat.poet_id
WHERE v1.position = 0
  AND length(v1.text) <= 50
  AND length(v2.text) <= 50
  AND poet.id NOT IN (0, 1, 36, 60, 68)
  AND cat.text != 'رباعیات'
ORDER BY v1.poem_id, v1.vorder
LIMIT 1 OFFSET ?;
