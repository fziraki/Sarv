-- Poet master record. cat_id links to their top-level category.
-- poet_meta provides the slug used as a fallback URL when cat.url is null.
CREATE TABLE poet (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    cat_id INTEGER NOT NULL,
    description TEXT NOT NULL
);

CREATE TABLE poet_meta (
    id INTEGER NOT NULL PRIMARY KEY,
    slug TEXT NOT NULL
);

-- Fetch a single poet with their download URL (cat.url or poet_meta.slug fallback)
-- and whether the poet's data is locally downloaded.
selectByIdWithCatUrl:
SELECT
    poet.id,
    poet.name,
    poet.cat_id,
    poet.description,
    COALESCE(cat.url, poet_meta.slug) AS cat_url,
    cat.id IS NOT NULL AS is_downloaded
FROM poet
LEFT JOIN cat ON cat.id = poet.cat_id
LEFT JOIN poet_meta ON poet_meta.id = poet.id
WHERE poet.id = ?;

-- Fetch all poets with download URLs and download status (poet list screen).
selectAllWithCatUrl:
SELECT
    poet.id,
    poet.name,
    poet.cat_id,
    poet.description,
    COALESCE(cat.url, poet_meta.slug) AS cat_url,
    cat.id IS NOT NULL AS is_downloaded
FROM poet
LEFT JOIN cat ON cat.id = poet.cat_id
LEFT JOIN poet_meta ON poet_meta.id = poet.id;

-- Find a poet id by partial name match (used to resolve poet from imported data).
selectIdByNameLike:
SELECT id
FROM poet
WHERE name LIKE ?
LIMIT 1;
