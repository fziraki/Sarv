-- Poem record. Each poem belongs to a category (cat_id) and has a title and download URL.
CREATE TABLE poem (
    id INTEGER NOT NULL PRIMARY KEY,
    cat_id INTEGER NOT NULL,
    title TEXT NOT NULL,
    url TEXT NOT NULL
);

-- Fetch poems for a category with pagination (poem list screen).
selectByCatIdPaged:
SELECT id, title
FROM poem
WHERE cat_id = ?
ORDER BY id
LIMIT :limit OFFSET :offset;

-- Fetch full poem details: title, poet name, and category name (poem detail screen).
selectDetailById:
SELECT
    poem.title,
    poet.name AS poet_name,
    cat.text AS category_name
FROM poem
JOIN cat ON cat.id = poem.cat_id
JOIN poet ON poet.id = cat.poet_id
WHERE poem.id = ?;

-- Resolve the poet who owns a given poem (used by the game to find poet context).
selectPoetForPoemId:
SELECT
    poet.id AS poet_id,
    poet.name AS poet_name
FROM poem
JOIN cat ON cat.id = poem.cat_id
JOIN poet ON poet.id = cat.poet_id
WHERE poem.id = ?;

-- Fetch multiple poems by id list with poet/category info (bulk lookup for SRS/import).
selectByIds:
SELECT
    poem.id,
    poem.title,
    poet.name AS poet_name,
    cat.text AS category_name
FROM poem
JOIN cat ON cat.id = poem.cat_id
JOIN poet ON poet.id = cat.poet_id
WHERE poem.id IN ?
ORDER BY poet.name, cat.text, poem.id;
